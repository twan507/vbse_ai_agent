# Chỉ ignore temp thuần tuý của Office/OS — không phải artifact workspace.
~$*
*.tmp
.~lock.*
Thumbs.db
desktop.ini

# CHÚ Ý: KHÔNG ignore bản sao conflict OneDrive (*-DESKTOP-*, *conflict*).
# Chúng phải hiện trong git status như bất thường để AI báo user xử lý
# (CLAUDE.md mục 2.2). Ignore chúng = giấu lỗi sync.

# Bản render máy — sinh lại được từ carrier MD (CLAUDE.md mục 7.2).
# Bản KHÔNG tái tạo được là outputs/sent/ (user sửa tay) — cái đó PHẢI commit.
outputs/pptx/
outputs/docx/

# Cấu hình máy riêng. .claude/settings.json thì CÓ commit (chứa hook luật git).
.claude/settings.local.json
